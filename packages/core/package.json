{
    "name": "@takimcizgisi/core",
    "version": "0.4.0",
    "description": "AJAN yerel AI motoru — otonom yerel kodlama ajanı (node-llama-cpp, Gemma/Qwen GGUF). Discord dahil.",
    "type": "module",
    "license": "GPL-3.0",
    "author": "TakimCizgisi Yazilim Gelistirme Grubu",
    "keywords": [
        "ai",
        "llm",
        "local",
        "agent",
        "coding-agent",
        "llama-cpp",
        "gemma",
        "cuda",
        "discord-rpc"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/takimcizgisi/ajan.git"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "config"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "test:tools": "tsx scripts/smoke-tools.ts",
        "test:new": "tsx scripts/smoke-new-tools.ts",
        "prepack": "npm run clean && npm run build"
    },
    "engines": {
        "node": ">=26.4.0"
    },
    "allowScripts": {
        "node-llama-cpp": true
    },
    "dependencies": {
        "@xhayper/discord-rpc": "^1.3.4",
        "adm-zip": "^0.6.0",
        "js-yaml": "^5.3.0",
        "node-llama-cpp": "^3.19.1"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.13.3",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}