{
    "name": "takimcizgisi-ajan-monorepo",
    "version": "0.0.0",
    "private": true,
    "description": "AJAN AI monorepo — @takimcizgisi/core (yerel AI motoru), @takimcizgisi/ajan-vscode (VSCode uzantısı), @takimcizgisi/ajan (Electron GUI + paket yöneticisi)",
    "license": "GPL-3.0",
    "author": "TakimCizgisi Yazilim Gelistirme Grubu",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=26.4.0"
    },
    "scripts": {
        "build": "npm run build -w packages/core && npm run build -w packages/vscode",
        "build:core": "npm run build -w packages/core",
        "build:vscode": "npm run build -w packages/vscode",
        "build:electron": "npm run build -w packages/ajan",
        "dev:electron": "npm run dev -w packages/ajan",
        "start:electron": "npm run start -w packages/ajan",
        "vscode:package": "node scripts/package-vscode.mjs",
        "test:tools": "npm run test:tools -w packages/core",
        "clean": "node scripts/clean.mjs",
        "release": "node scripts/release.mjs",
        "release:publish-all": "node scripts/release.mjs --publish-all",
        "release:publish-core": "node scripts/release.mjs --publish-core",
        "release:electron": "node scripts/release.mjs --publish-electron"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "node-llama-cpp": true,
        "esbuild": true,
        "electron": true
    }
}